# ============================================================
# ระบบจองห้องประชุม TNN — ตัวอย่างไฟล์ Environment variables
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#   cp .env.example .env.local
#
# กฎเหล็ก (บรีฟข้อ 16 และ 22.8)
#   1. ไฟล์นี้ต้องไม่มี "ค่าจริง" ของ secret เด็ดขาด มีแต่ชื่อกับคำอธิบาย
#   2. ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ = เปิดเผยต่อ browser ห้ามใส่ความลับ
#   3. ตัวแปรอื่นทั้งหมด = server only ห้ามนำไปใช้ใน component ฝั่ง client
#   4. ห้าม commit ไฟล์ .env / .env.local ขึ้น git (มีใน .gitignore แล้ว)
# ============================================================

# ------------------------------------------------------------
# แอปพลิเคชัน
# ------------------------------------------------------------
# สภาพแวดล้อม: development | preview | staging | production | test
APP_ENV=development
# โซนเวลาที่ใช้แสดงผล (ฐานข้อมูลเก็บเป็น UTC เสมอ)
APP_TIMEZONE=Asia/Bangkok
# URL เต็มของเว็บ ใช้ประกอบลิงก์ในอีเมลและ LINE  [เปิดเผยต่อ browser]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# ฐานข้อมูล PostgreSQL (Neon)
# ------------------------------------------------------------
# ★ สำคัญมาก: DATABASE_URL ที่เว็บใช้ ต้องเป็นเส้นที่ชื่อ host มี -pooler
#   ถ้าใช้เส้นตรงบน Vercel จะเปิด connection เต็มโควตาจนเว็บล่มตอนคนเข้าพร้อมกัน
#   รูปแบบ: postgresql://neondb_owner:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# เส้นตรงที่ไม่มี -pooler ใช้เฉพาะรัน migration บนเครื่องตัวเอง
# ★ ห้ามใส่ตัวแปรนี้ใน Vercel
DIRECT_URL=

# ต่อฐานข้อมูลด้วย SSL หรือไม่
# มีผลเฉพาะเมื่อ DATABASE_URL ไม่มี sslmode อยู่ในสาย
# สายของ Neon มี ?sslmode=require ติดมาแล้ว ซึ่งจะชนะค่านี้ (ปล่อย true ไว้ได้)
# PostgreSQL บนเครื่องตัวเองที่ไม่ได้เปิด TLS ให้ใช้ false และไม่ต้องมี sslmode ในสาย
DATABASE_SSL=false
# จำนวน connection สูงสุดต่อหนึ่ง instance (Vercel serverless แนะนำ 3-5)
DATABASE_POOL_MAX=5

# ------------------------------------------------------------
# ระบบยืนยันตัวตน
# ------------------------------------------------------------
# กุญแจเซ็น session token — สร้างด้วย: openssl rand -base64 48
# ต้องยาวอย่างน้อย 32 ตัวอักษร และแยกคนละค่าในแต่ละ environment
AUTH_SECRET=
# อายุ session (ชั่วโมง)
AUTH_SESSION_HOURS=12
# เปิดให้สมัครเองหรือไม่ (false = ต้องให้ผู้ดูแลระบบเชิญเท่านั้น)
AUTH_ALLOW_SELF_REGISTER=true
# จำกัดโดเมนอีเมลที่สมัครได้ คั่นด้วยจุลภาค เช่น tnnthailand.com,tnn16.co.th
# เว้นว่าง = อนุญาตทุกโดเมน
AUTH_ALLOWED_EMAIL_DOMAINS=

# ------------------------------------------------------------
# อีเมล (Resend)
# ------------------------------------------------------------
# resend = ส่งจริง | log = เขียนลง log และฐานข้อมูลอย่างเดียว (ใช้ตอนพัฒนา)
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM="TNN Meeting <no-reply@notify.example.com>"
EMAIL_REPLY_TO=meeting-support@example.com
# ใช้ตรวจลายเซ็น webhook แจ้ง bounce/complaint จากผู้ให้บริการอีเมล
EMAIL_WEBHOOK_SECRET=

# ------------------------------------------------------------
# LINE Messaging API
# ------------------------------------------------------------
# messaging-api = ส่งจริง | log = เขียนลง log อย่างเดียว (ใช้ตอนพัฒนา)
LINE_PROVIDER=log
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ------------------------------------------------------------
# งานเบื้องหลังและความปลอดภัย
# ------------------------------------------------------------
# กุญแจลับของ endpoint /api/cron/* — สร้างด้วย: openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
LOG_LEVEL=info
RELEASE_VERSION=dev

# ------------------------------------------------------------
# เทสต์ (ใส่ในไฟล์ .env.test.local)
# ------------------------------------------------------------
# ฐานข้อมูลสำหรับเทสต์ Integration — ชื่อฐานข้อมูลต้องมีคำว่า "test"
# เพื่อกันการล้างฐานข้อมูลจริงโดยไม่ตั้งใจ
TEST_DATABASE_URL=
